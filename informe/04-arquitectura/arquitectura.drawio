        <mxCell id="u1" value="auth.users · tipos_espacio&lt;br&gt;espacios · estados_reserva&lt;br&gt;reservas" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD2DC;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Verdana;fontSize=11;fontColor=#1A202C;" vertex="1" parent="C4">
