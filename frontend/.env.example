# Copiar como .env.local y completar con los datos del proyecto de Supabase:
# Project Settings > API Keys (clave publicable) y Project Settings > General (URL)
#
# La clave PUBLICABLE puede ir en el navegador: es publica por diseno.
# Lo que protege los datos es Row Level Security, no esta clave.
# La clave SECRETA (sb_secret_...) NUNCA va aqui ni en ningun archivo del frontend.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
